{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IS&S Capture",
  "type": "object",
  "required": [
    "capture_id",
    "agency_id",
    "status"
  ],
  "properties": {
    "capture_id": {
      "type": "string"
    },
    "agency_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "target",
        "researching",
        "qualified",
        "pursuing",
        "submitted",
        "won",
        "lost",
        "relationship"
      ]
    },
    "strategy": {
      "type": "string"
    },
    "next_action": {
      "type": "string"
    },
    "relationship_strength": {
      "type": "number"
    }
  }
}
