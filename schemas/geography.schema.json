{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IS&S Geography",
  "type": "object",
  "required": [
    "id",
    "type",
    "name"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "type": {
      "enum": [
        "region",
        "county",
        "municipality"
      ]
    },
    "name": {
      "type": "string"
    },
    "parent_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "planned",
        "active",
        "verified",
        "archived"
      ]
    }
  }
}
