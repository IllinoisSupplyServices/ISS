{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IS&S Award",
  "type": "object",
  "required": [
    "award_id",
    "agency",
    "verification_status"
  ],
  "properties": {
    "award_id": {
      "type": "string"
    },
    "agency": {
      "type": "string"
    },
    "vendor": {
      "type": "string"
    },
    "award_date": {
      "type": "string"
    },
    "award_value": {
      "type": "number"
    },
    "verification_status": {
      "enum": [
        "verified",
        "pending",
        "unverified"
      ]
    },
    "source_refs": {
      "type": "array"
    }
  }
}
