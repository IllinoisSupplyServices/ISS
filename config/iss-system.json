{
  "system": "IS&S",
  "platform": "ISSPOS",
  "architecture_version": "1.0.1",
  "purpose": "Government procurement intelligence, opportunity discovery, sourcing, pricing, competitive intelligence and capture management.",
  "authoritative_layers": {
    "google_drive": "canonical_business_state",
    "dropbox": "evidence_provenance_and_recovery",
    "github": "system_control_derived_intelligence_and_authorized_replica_only",
    "json": "machine_readable_operating_model"
  },
  "authority_rules": {
    "raw_evidence_promotion": "prohibited_without_explicit_validation_and_authorization",
    "stale_evidence_promotion": "prohibited",
    "github_business_state_promotion": "prohibited_except_explicitly_authorized_replica_only_mirror"
  },
  "geographic_scope": {
    "country": "US",
    "state": "Illinois",
    "regions": 10,
    "counties": 102
  },
  "capture_chain": [
    "region",
    "county",
    "municipality",
    "agency",
    "opportunity",
    "bid",
    "award"
  ],
  "coverage_rule": "verified_award_or_contract_only",
  "sourcing_rule": "domestic_sources_only_unless_explicitly_authorized",
  "price_rule": "separate_acquisition_floor_from_defensible_market_ceiling"
}
