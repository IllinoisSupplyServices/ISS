  "state_classes": [
    "VERIFIED",
    "OBSERVED",
    "INFERRED",
    "UNKNOWN",
    "STALE",
    "CONFLICT"
  ],
  "hard_rules": {
    "no_unverified_fact_promotion": true,
    "no_bid_below_landed_cost": true,
    "net_profit_required": true,
    "equivalent_first": true,
    "saved_supplier_memory_first": true,
    "product_image_required_every_candidate": true,
    "direct_product_url_required_every_candidate": true,
    "sourcing_presentation_option_2_required": true,
    "visible_image_slot_required_every_candidate": true,
    "missing_verified_image_requires_rendered_placeholder": true,
    "placeholder_does_not_count_as_product_evidence": true,
    "sourcing_reasoning_must_be_persisted": true,
    "sourcing_rejections_and_selection_rationale_must_be_saved": true,
    "sourcing_searches_evidence_and_calculations_must_be_saved": true,
    "sourcing_user_corrections_must_be_saved": true,
    "hidden_chain_of_thought_must_not_be_persisted": true,
    "supplier_communications_skill_required_for_supplier_outreach": true,
    "supplier_outreach_relationship_first": true,
    "supplier_outreach_human_commercial_contact_preferred": true,
    "supplier_generic_signup_only_is_wrong_outcome": true,
    "supplier_credit_terms_not_default_lead": true,
    "supplier_and_subcontractor_roles_must_remain_distinct": true,
    "supplier_outreach_must_not_imply_guaranteed_volume_or_awards": true,
    "supplier_outreach_avoid_unnecessary_sensitive_disclosure": true,
    "external_action_requires_explicit_approval": true,
    "error_fix_requires_complete_new_file": true,
    "patch_or_addendum_error_fix_prohibited": true,
    "transitive_affected_files_must_be_replaced": true,
    "superseded_files_must_be_deleted_after_validated_replacement": true
  }
}
