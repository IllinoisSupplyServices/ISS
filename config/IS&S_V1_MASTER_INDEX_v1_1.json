{
  "system": "IS&S V1",
  "version": "1.3.0",
  "status": "ACTIVE_FOUNDATION",
  "read_order": [
    "config/iss-system.json",
    "config/IS&S_V1_NAMING.json",
    "config/IS&S_V1_MASTER_INDEX_v1_1.json",
    "config/IS&S_V1_ERROR_REPLACEMENT_POLICY.json",
    "config/IS&S_V1_SOURCING_POLICY.json",
    "config/IS&S_V1_SOURCING_PRESENTATION_STANDARD.json",
    "config/IS&S_V1_SOURCING_REASONING_PERSISTENCE.json",
    "config/IS&S_V1_GATE_POLICY.json",
    "skills/supplier-communications/SKILL.md",
    "schemas/supplier-memory.schema.json",
    "schemas/sourcing-reasoning.schema.json"
  ],
  "planes": {
    "github": "control_plane",
    "google_drive": "canonical_business_state",
    "dropbox": "evidence_provenance_and_recovery"
